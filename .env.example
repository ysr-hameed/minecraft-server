MC_PANEL_PASSWORD=admin123
SECRET_KEY=replace-with-a-long-random-secret

MC_BEDROCK_PORT=19132
MC_BEDROCK_PORT_V6=19133
MC_MAX_PLAYERS=20
MC_MOTD=SlyxCraft Bedrock Server
MC_GAMEMODE=survival
MC_DIFFICULTY=normal
MC_LEVEL_NAME=world

# Default PocketMine release used until changed in Settings.
# The newest verified release is detected automatically.
MC_POCKETMINE_VERSION=5.51.1
# Automatically switch to newest verified release.
MC_AUTO_UPDATE=true
MC_VERSION_CACHE_TTL=21600

MC_PANEL_HOST=0.0.0.0
MC_PANEL_PORT=5000
MC_MAX_UPLOAD_MB=1024
BACKUP_HOUR=3
MC_STOP_TIMEOUT=20

# Optional: use a specific PocketMine-compatible PHP binary.
# MC_PHP_BINARY=/absolute/path/to/php

# Optional: move runtime data outside the panel folder.
# MC_SERVER_DIR=/absolute/path/to/minecraft_server_bedrock
# MC_BACKUP_DIR=/absolute/path/to/backups

# Optional S3 copies. boto3 is installed from requirements.txt.
# For an S3-compatible endpoint (e.g. Neon object storage) also set AWS_ENDPOINT_URL_S3.
AWS_BUCKET_NAME=
# AWS_ENDPOINT_URL_S3=https://your-s3-compatible-endpoint
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
