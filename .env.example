MC_PANEL_PASSWORD=change-me
SECRET_KEY=replace-with-a-long-random-secret

MC_PANEL_HOST=0.0.0.0
MC_PANEL_PORT=5000
MC_MAX_UPLOAD_MB=1024

# Official Bedrock Dedicated Server location and network settings.
MC_SERVER_DIR=/opt/minecraft-panel/bedrock_server
MC_BACKUP_DIR=/opt/minecraft-panel/backups
MC_SERVER_PORT=19132
MC_SERVER_PORT_V6=19133
# Public IP mapping for NetherNet gameplay (recommended on NAT/VPS).
# MC_UDP_PORTS=203.0.113.10:19133:19133
# Latest official BDS builds require nethernet. RakNet is only for old builds.
MC_TRANSPORT=nethernet

MC_MOTD=SlyxCraft Bedrock Server
MC_MAX_PLAYERS=20
MC_GAMEMODE=survival
MC_DIFFICULTY=normal
MC_LEVEL_NAME=Bedrock level
MC_VIEW_DISTANCE=10
MC_TICK_DISTANCE=4
MC_MAX_THREADS=4

MC_AUTO_UPDATE=true
MC_AUTO_START=true
MC_VERSION_CACHE_TTL=21600
MC_STOP_TIMEOUT=30
MC_START_TIMEOUT=90
BACKUP_HOUR=3

# Optional S3-compatible backup copies (Neon object storage, AWS, MinIO, ...).
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BACKUP_PREFIX=minecraft-backups
