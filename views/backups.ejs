<%- include('partials/head', { title: 'Backups', active: active }) %>
<section class="page-head">
  <div>
    <span class="eyebrow">Disaster recovery</span>
    <h1>Backups</h1>
    <p class="sub">Daily automatic backup at <%= backupHour %>:00 · uses the official <code>save hold</code> / <code>save resume</code> commands while zipping.</p>
  </div>
  <div class="head-actions">
    <form method="POST" action="/worlds">
      <input type="hidden" name="action" value="backup">
      <button class="btn btn-green" type="submit">Create backup now</button>
    </form>
    <a class="btn btn-ghost" href="/worlds">Worlds</a>
  </div>
</section>

<section class="notice">
  <b>Restore is safe:</b> the server is stopped first, a fresh safety backup is created, then the archive is restored. The server is left stopped so you can review the files before starting again.
</section>

<article class="card">
  <div class="card-head">
    <div><span class="eyebrow">Archive</span><h2><%= backups.length %> backups</h2></div>
    <span class="badge badge-neutral">backup_YYYY-MM-DD_HH-MM_#N_TYPE.zip</span>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Backup</th><th>Type</th><th>Created</th><th>Size</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (backups.length) { %>
          <% backups.forEach(function (backup) { %>
            <tr>
              <td><b class="mono"><%= backup.name %></b></td>
              <td>
                <% if (backup.type === 'daily') { %>
                  <span class="badge badge-green">daily</span>
                <% } else if (backup.type.indexOf('pre-') === 0) { %>
                  <span class="badge badge-violet">safety</span>
                <% } else { %>
                  <span class="badge badge-neutral"><%= backup.type %></span>
                <% } %>
              </td>
              <td><%= backup.date %></td>
              <td><%= backup.size_h %></td>
              <td>
                <div class="action-row">
                  <a class="btn btn-ghost btn-tiny" href="/backup/download/<%= encodeURIComponent(backup.name) %>">Download</a>
                  <form method="POST" action="/worlds" onsubmit="return confirm('Stop the server and restore this backup? A safety backup is created first.');">
                    <input type="hidden" name="action" value="restore">
                    <input type="hidden" name="backup" value="<%= backup.name %>">
                    <button class="btn btn-violet btn-tiny" type="submit">Restore</button>
                  </form>
                  <form method="POST" action="/worlds" onsubmit="return confirm('Delete this backup file?');">
                    <input type="hidden" name="action" value="delete_backup">
                    <input type="hidden" name="backup" value="<%= backup.name %>">
                    <button class="btn btn-red btn-tiny" type="submit">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="5"><div class="empty">No backups yet. Create one before installing packs or changing worlds.</div></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</article>

<section class="two-col">
  <article class="card muted-card">
    <span class="eyebrow">What is included</span>
    <h2>Complete server state</h2>
    <div class="safe-list">
      <span>All Bedrock worlds and player data</span>
      <span>server.properties, allowlist.json and permissions.json</span>
      <span>Behavior and resource packs</span>
      <span>Whitelist, operators and ban lists</span>
    </div>
  </article>
  <article class="card muted-card">
    <span class="eyebrow">Cloud copy</span>
    <h2>S3 upload <%= s3Enabled ? 'on' : 'off' %></h2>
    <p class="sub">
      <% if (s3Enabled) { %>
        Every backup is also uploaded to <code>s3://<%= s3Bucket %>/minecraft-backups/</code> using the endpoint in <code>.env</code>.
      <% } else { %>
        Set <code>AWS_BUCKET_NAME</code>, <code>AWS_ACCESS_KEY_ID</code>, <code>AWS_SECRET_ACCESS_KEY</code> and <code>AWS_REGION</code> in <code>.env</code> to enable off-device copies. Local backups always work.
      <% } %>
    </p>
    <code class="kbd">npm install @aws-sdk/client-s3</code>
  </article>
</section>
<%- include('partials/foot') %>
