<%- include('partials/head', { title: 'Worlds', active: active }) %>
<section class="page-head">
  <div>
    <span class="eyebrow">World control</span>
    <h1>Worlds and backups</h1>
    <p class="sub">Official Bedrock worlds live in <code>bedrock_server/worlds/</code> · active world <b><%= activeWorld %></b></p>
  </div>
  <div class="head-actions">
    <a class="btn btn-ghost" href="/backups">Backup center</a>
  </div>
</section>

<section class="two-col worlds-layout">
  <div class="stack">
    <article class="card">
      <div class="card-head">
        <div><span class="eyebrow">Installed</span><h2>Your worlds</h2></div>
        <span class="badge badge-neutral"><%= worlds.length %> worlds</span>
      </div>
      <div class="list-stack">
        <% if (worlds.length) { %>
          <% worlds.forEach(function (world) { %>
            <div class="world-row">
              <div class="world-main">
                <div class="world-title">
                  <b><%= world.name %></b>
                  <% if (world.active) { %><span class="badge badge-green">ACTIVE</span><% } %>
                </div>
                <small><%= world.size_h %> · <%= world.files %> files</small>
              </div>
              <div class="action-row">
                <a class="btn btn-ghost btn-tiny" href="/world/download/<%= encodeURIComponent(world.name) %>">Download</a>
                <% if (!world.active) { %>
                  <form method="POST" action="/worlds">
                    <input type="hidden" name="action" value="activate_world">
                    <input type="hidden" name="world" value="<%= world.name %>">
                    <button class="btn btn-violet btn-tiny" type="submit">Activate</button>
                  </form>
                  <form method="POST" action="/worlds" onsubmit="return confirm('Delete this world? A safety backup is created first.');">
                    <input type="hidden" name="action" value="delete_world">
                    <input type="hidden" name="world" value="<%= world.name %>">
                    <button class="btn btn-red btn-tiny" type="submit">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty">No worlds yet. Start the server once or create a world below.</div>
        <% } %>
      </div>
    </article>

    <article class="card">
      <div class="card-head">
        <div><span class="eyebrow">Import</span><h2>Upload a world ZIP</h2></div>
      </div>
      <form method="POST" action="/world/upload" enctype="multipart/form-data" class="form-grid">
        <label>World folder name
          <input class="input" name="world_name" placeholder="my_world">
        </label>
        <label>World archive (.zip)
          <input class="input" type="file" name="world_zip" accept=".zip" required>
        </label>
        <label class="check-row">
          <input type="checkbox" name="replace"> Replace an existing world with the same name
        </label>
        <button class="btn btn-green" type="submit">Upload world</button>
      </form>
      <p class="sub">The ZIP can contain the world files at the root or inside one folder. A safety ZIP is made before replacing a world.</p>
    </article>

    <article class="card">
      <div class="card-head">
        <div><span class="eyebrow">Generate</span><h2>Create a new world</h2></div>
      </div>
      <form method="POST" action="/worlds" class="form-grid">
        <input type="hidden" name="action" value="create">
        <label>World name
          <input class="input" name="name" placeholder="world2" required pattern="[A-Za-z0-9_-]{1,32}">
        </label>
        <label>Seed
          <input class="input" name="seed" placeholder="Leave empty for random">
        </label>
        <label>Game mode
          <select class="select" name="gamemode">
            <option value="survival">Survival</option>
            <option value="creative">Creative</option>
            <option value="adventure">Adventure</option>
            <option value="spectator">Spectator</option>
          </select>
        </label>
        <label>Difficulty
          <select class="select" name="difficulty">
            <option value="peaceful">Peaceful</option>
            <option value="easy">Easy</option>
            <option value="normal" selected>Normal</option>
            <option value="hard">Hard</option>
          </select>
        </label>
        <label>World type
          <select class="select" name="level_type">
            <option value="DEFAULT">Default</option>
            <option value="FLAT">Flat</option>
            <option value="LEGACY">Legacy</option>
          </select>
        </label>
        <button class="btn btn-violet" type="submit">Create and activate</button>
      </form>
      <p class="sub">The world is generated by the official server on the next start. Restart after creating it.</p>
    </article>
  </div>

  <div class="stack">
    <article class="card">
      <div class="card-head">
        <div><span class="eyebrow">Snapshots</span><h2>Backups</h2></div>
        <form method="POST" action="/worlds">
          <input type="hidden" name="action" value="backup">
          <button class="btn btn-green btn-small" type="submit">Create backup</button>
        </form>
      </div>
      <p class="sub">Manual and daily backups use <code>backup_YYYY-MM-DD_HH-MM_#12.zip</code>. Worlds, player data, allow lists and settings are included.</p>
      <div class="list-stack">
        <% if (backups.length) { %>
          <% backups.forEach(function (backup) { %>
            <div class="backup-row">
              <div><b class="mono"><%= backup.name %></b><small><%= backup.date %> · <%= backup.size_h %></small></div>
              <div class="action-row">
                <a class="btn btn-ghost btn-tiny" href="/backup/download/<%= encodeURIComponent(backup.name) %>">Download</a>
                <form method="POST" action="/worlds" onsubmit="return confirm('Restore this backup? The server is stopped and a safety backup is created first.');">
                  <input type="hidden" name="action" value="restore">
                  <input type="hidden" name="backup" value="<%= backup.name %>">
                  <button class="btn btn-violet btn-tiny" type="submit">Restore</button>
                </form>
                <form method="POST" action="/worlds" onsubmit="return confirm('Delete this backup file?');">
                  <input type="hidden" name="action" value="delete_backup">
                  <input type="hidden" name="backup" value="<%= backup.name %>">
                  <button class="btn btn-red btn-tiny" type="submit">Delete</button>
                </form>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty">No backups yet. Create the first snapshot now.</div>
        <% } %>
      </div>
    </article>

    <article class="card muted-card">
      <span class="eyebrow">World safety</span>
      <h2>Restart without losing data</h2>
      <p class="sub">Always stop with the panel before restoring or replacing a world. The panel also uses the official <code>save hold</code> / <code>save resume</code> commands while creating a backup.</p>
      <div class="safe-list">
        <span>World data stays inside the server folder</span>
        <span>Backups are stored outside the world folder</span>
        <span>World downloads are clean ZIP archives</span>
      </div>
    </article>
  </div>
</section>
<%- include('partials/foot') %>
