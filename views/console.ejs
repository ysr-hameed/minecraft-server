<%- include('partials/head', { title: 'Console', active: active }) %>
<section class="page-head">
  <div>
    <span class="eyebrow">Live terminal</span>
    <h1>Console and logs</h1>
    <p class="sub">Commands are written directly to the official Bedrock server console · <%= stats.port %> UDP</p>
  </div>
  <div class="head-actions">
    <span class="badge <%= running ? 'badge-green' : 'badge-red' %>" id="console-status">
      <span class="badge-dot"></span><span id="console-status-text"><%= running ? 'ONLINE' : 'OFFLINE' %></span>
    </span>
    <form method="POST" action="/server/start"><button class="btn btn-green" type="submit" <%= running ? 'disabled' : '' %>>Start</button></form>
    <form method="POST" action="/server/stop" onsubmit="return confirm('Stop the server safely?');"><button class="btn btn-red" type="submit" <%= !running ? 'disabled' : '' %>>Stop</button></form>
    <form method="POST" action="/server/restart" onsubmit="return confirm('Restart the Bedrock server now?');"><button class="btn btn-violet" type="submit">Restart</button></form>
  </div>
</section>

<section class="console-layout">
  <article class="card console-card">
    <div class="console-bar">
      <span class="console-lights"><i></i><i></i><i></i></span>
      <span class="mono">bedrock_server console</span>
      <span class="console-meta"><span id="console-players"><%= stats.player_count %></span> online · <span id="console-uptime"><%= stats.uptime %></span></span>
    </div>
    <pre class="console-log" id="console-log"><%= logs.join('\n') %></pre>
    <form method="POST" action="/console" class="console-form">
      <span class="prompt">›</span>
      <input class="input console-input" id="command-input" name="command" placeholder="say Hello from SlyxPanel" autocomplete="off" spellcheck="false" required>
      <button class="btn btn-green" type="submit">Send</button>
    </form>
  </article>

  <aside class="card console-side">
    <span class="eyebrow">Bedrock commands</span>
    <h2>Quick commands</h2>
    <div class="quick-commands">
      <button type="button" data-cmd="list">list</button>
      <button type="button" data-cmd="say Hello from SlyxPanel">say Hello</button>
      <button type="button" data-cmd="time set day">time set day</button>
      <button type="button" data-cmd="weather clear">weather clear</button>
      <button type="button" data-cmd="gamemode creative @a">creative for all</button>
      <button type="button" data-cmd="give @p diamond 64">give diamonds</button>
      <button type="button" data-cmd="save hold">save hold</button>
      <button type="button" data-cmd="save resume">save resume</button>
    </div>
    <p class="sub">Official Bedrock console commands work here without a leading slash. Player commands such as <code>kick</code>, <code>ban</code>, <code>op</code> and <code>allowlist</code> are supported.</p>
    <div class="divider"></div>
    <span class="eyebrow">Online now</span>
    <div class="player-chips" id="online-chips">
      <% if (stats.players_online.length) { %>
        <% stats.players_online.forEach(function (player) { %><span class="chip"><%= player %></span><% }); %>
      <% } else { %>
        <span class="sub">No players connected.</span>
      <% } %>
    </div>
  </aside>
</section>
<%- include('partials/foot') %>
<script>
  (function () {
    const log = document.getElementById('console-log');
    const input = document.getElementById('command-input');
    const statusBadge = document.getElementById('console-status');
    const statusText = document.getElementById('console-status-text');
    const players = document.getElementById('console-players');
    const uptime = document.getElementById('console-uptime');
    const chips = document.getElementById('online-chips');
    document.querySelectorAll('[data-cmd]').forEach(function (button) {
      button.addEventListener('click', function () {
        input.value = button.getAttribute('data-cmd');
        input.focus();
      });
    });
    async function refreshLogs() {
      try {
        const response = await fetch('/api/logs', { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        const data = await response.json();
        const nearBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 80;
        log.textContent = data.logs.join('\n');
        if (nearBottom) log.scrollTop = log.scrollHeight;
        statusText.textContent = data.running ? 'ONLINE' : 'OFFLINE';
        statusBadge.classList.toggle('badge-green', !!data.running);
        statusBadge.classList.toggle('badge-red', !data.running);
        players.textContent = data.player_count;
        uptime.textContent = data.uptime ? data.uptime + 's' : '—';
        if (data.players && data.players.length) {
          chips.innerHTML = data.players.map(function (name) {
            const chip = document.createElement('span');
            chip.className = 'chip';
            chip.textContent = name;
            return chip.outerHTML;
          }).join('');
        } else {
          chips.innerHTML = '<span class="sub">No players connected.</span>';
        }
      } catch (error) {}
    }
    log.scrollTop = log.scrollHeight;
    setInterval(refreshLogs, 2000);
  })();
</script>
